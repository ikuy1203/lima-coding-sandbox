# make start / make create でインスタンスを作成するときに使う設定。
# cp .env.example .env でコピーして値を書く（.env は .gitignore で除外してある）。
#
# - Makefile が make の書式で読み込む（VM には --param で値だけを渡し、このファイル自体は渡さない）
# - 値に空白やカンマがあってもクォートは要らない（両端を " か ' で囲んだときは、その 1 組を取り除く）
# - # から行末はコメントになる
# - 空のときは既定値を使う。コマンドラインで指定した値（make start GIT_USER_NAME=... など）が最優先
# - 作成した後に変えても、今の VM には反映されない（make recreate で作り直す）

# Git のユーザ名とメールアドレス（空のときはホストの git config --global の値を使う）
GIT_USER_NAME=
GIT_USER_EMAIL=

# VM から host.lima.internal（ホストの 127.0.0.1）への接続を遮断するか（true / false）。空ならテンプレートの既定値（true）。
# ホストのプロキシ（http_proxy=http://127.0.0.1:...）を VM でも使うときは false にする（README.md の「ネットワーク」を参照）
BLOCK_HOST_LOOPBACK=

# エージェント向けの指示ファイル（~/.copilot/copilot-instructions.md、~/.gemini/config/rules/lima-coding-sandbox.md）を配置するか（true / false）。空ならテンプレートの既定値（false）。
# 有効にすると、VM の前提（マウントなし、docker ラッパーの制約、mise shims、手動ポート転送など）をまとめた指示ファイルを配置する
AGENT_INSTRUCTIONS=

# GitHub Copilot CLI と mise のインストール時のバージョン（空なら最新版）。
# 新しい版に問題があるときに、動作確認済みの版を指定して作り直すために使う（例: COPILOT_VERSION=1.0.91、MISE_VERSION=2026.10.7）。
# COPILOT_VERSION には prerelease も指定できる。指定が効くのはインストール時のみで、その後の更新は各ツールの更新コマンドで行う
# （herdr と Antigravity CLI は公式の install スクリプトがバージョン指定に未対応のため指定できない）
COPILOT_VERSION=
MISE_VERSION=
